+function Add-FailureEvidence([string]$Command, [object[]]$Output, [int]$ExitCode) {
+  $failureLog.Add("COMMAND=$Command")
+  foreach ($line in $Output) { $failureLog.Add([string]$line) }
+  $failureLog.Add("EXIT_CODE=$ExitCode")
