+}
+
+function Start-LauncherStub([int]$StatusCode) {
+  Write-Stub $StatusCode
+  $launcherPath = Join-Path $testRoot 'http-launcher.ps1'
+  $childPidPath = Join-Path $testRoot 'http-child.pid'
