# WorldFirst readiness placeholders only. Never commit real values.
WORLDFIRST_MODE=WORLDFIRST_COLLECTION_ACCOUNT
WORLDFIRST_GLOBAL_CHECKOUT=NOT_AVAILABLE_CURRENT_ACCOUNT
WORLDFIRST_ENVIRONMENT=sandbox
WORLDFIRST_CLIENT_ID=<SET_LOCALLY_AFTER_ELIGIBILITY_REVIEW>
WORLDFIRST_MERCHANT_ID=<SET_LOCALLY_AFTER_ELIGIBILITY_REVIEW>
WORLDFIRST_API_BASE_URL=<SET_LOCALLY_FROM_OFFICIAL_DOCUMENTATION>
WORLDFIRST_WEBHOOK_SECRET=<SET_LOCALLY>
WORLDFIRST_REQUEST_SIGNING_KEY=<SET_LOCALLY>
WORLDFIRST_IDEMPOTENCY_HEADER=X-Idempotency-Key
WORLDFIRST_RETURN_URL=<SET_LOCALLY_TO_SAME_ORIGIN_CHECKOUT_RETURN>

# For collection-account mode, configure the separate checkout gateway behind
# the provider-neutral Medusa adapter; do not use collection-account data as a
# customer payment credential.
CHECKOUT_GATEWAY_REQUIRED=YES
