@@ -0,0 +1,152 @@
+[CmdletBinding()]
+param()
+
+$ErrorActionPreference = "Stop"
+
+$scriptPath = Join-Path $PSScriptRoot "92-prepare-review-staging.ps1"
+$sourceRoot = (Resolve-Path (Join-Path $PSScriptRoot "../..")).Path
+$documentCenterRoot = Split-Path -Parent $sourceRoot
+$workspaceParent = Split-Path -Parent $documentCenterRoot
+$trustedStagingRoot = Join-Path $workspaceParent "_review_stage"
+$runId = "RT-01-" + [Guid]::NewGuid().ToString("N")
+$testRoot = Join-Path $trustedStagingRoot ("security-tests\" + $runId)
+$outsideTarget = Join-Path $workspaceParent ("_" + $runId + "-outside-target")
+$packageRoot = Join-Path $testRoot "outputs"
+$packagePath = Join-Path $packageRoot "package.zip"
+$packageManifestPath = Join-Path $packageRoot "manifest.md"
+$packageId = "RT-01-$runId"
+$junction = Join-Path $testRoot "junction-stage"
+
+$failures = New-Object System.Collections.Generic.List[string]
+$results = New-Object System.Collections.Generic.List[string]
+$shell = (Get-Command pwsh -ErrorAction SilentlyContinue).Source
+if (-not $shell) { $shell = (Get-Command powershell -ErrorAction Stop).Source }
+
+function Add-Result([string]$Name, [bool]$Passed, [string]$Detail) {
+  $state = if ($Passed) { "PASS" } else { "FAIL" }
+  [void]$results.Add("$Name=$state;$Detail")
+  if (-not $Passed) { [void]$failures.Add($Name) }
+}
+
+function New-TestDirectory([string]$Path) {
+  [System.IO.Directory]::CreateDirectory($Path) | Out-Null
+}
+
+function Write-TestFile([string]$Path, [string]$Content) {
+  [System.IO.Directory]::CreateDirectory((Split-Path -Parent $Path)) | Out-Null
+  [System.IO.File]::WriteAllText($Path, $Content, (New-Object System.Text.UTF8Encoding($false)))
+}
+
+function Get-TestFileText([string]$Path) {
+  return [System.IO.File]::ReadAllText($Path)
+}
+
+function Invoke-StagingScript([string]$Name, [string]$StagingPath, [bool]$ExpectedSuccess) {
+  $output = @(& $shell -NoLogo -NoProfile -ExecutionPolicy Bypass -File $scriptPath `
+    -StagingPath $StagingPath `
+    -PackagePath $packagePath `
+    -PackageManifestPath $packageManifestPath `
+    -PackageId $packageId 2>&1 | ForEach-Object { $_.ToString() })
+  $exitCode = $LASTEXITCODE
+  $actualSuccess = $exitCode -eq 0
+  Add-Result $Name ($actualSuccess -eq $ExpectedSuccess) ("exit=$exitCode;output=" + (($output -join " ").Trim()))
+  return [pscustomobject]@{ ExitCode = $exitCode; Output = $output }
+}
+
+function Assert-Unchanged([string]$Name, [string]$Path, [string]$Before) {
+  $exists = Test-Path -LiteralPath $Path
+  $after = if ($exists) { Get-TestFileText $Path } else { "<MISSING>" }
+  Add-Result $Name ($exists -and $after -ceq $Before) "exists=$exists"
+}
+
+$sourceProtectedFile = Join-Path $sourceRoot "PROJECT_STATUS.json"
+$documentProtectedFile = Join-Path $documentCenterRoot "00_HANDOFF.md"
+$sourceBefore = Get-TestFileText $sourceProtectedFile
+$documentBefore = Get-TestFileText $documentProtectedFile
+
+try {
+  New-TestDirectory $testRoot
+  New-TestDirectory $outsideTarget
+  Write-TestFile (Join-Path $outsideTarget "outside-sentinel.txt") "outside-sentinel"
+
+  $invalidPaths = @(
+    @{ Name = "REJECT_SOURCE_ROOT"; Path = $sourceRoot },
+    @{ Name = "REJECT_SOURCE_DESCENDANT"; Path = Join-Path $sourceRoot "not-a-stage" },
+    @{ Name = "REJECT_SOURCE_CASE_AND_TRAILING_SEPARATOR"; Path = $sourceRoot.ToUpperInvariant() + "\" },
+    @{ Name = "REJECT_DOCUMENT_CENTER_ROOT"; Path = $documentCenterRoot },
+    @{ Name = "REJECT_DOCUMENT_CENTER_DESCENDANT"; Path = Join-Path $documentCenterRoot "not-a-stage" },
+    @{ Name = "REJECT_WORKSPACE_ANCESTOR"; Path = $workspaceParent },
+    @{ Name = "REJECT_USER_HOME"; Path = [Environment]::GetFolderPath([Environment+SpecialFolder]::UserProfile) },
+    @{ Name = "REJECT_DISK_ROOT"; Path = [System.IO.Path]::GetPathRoot($sourceRoot) },
+    @{ Name = "REJECT_TRUSTED_ROOT"; Path = $trustedStagingRoot },
+    @{ Name = "REJECT_TRUSTED_ROOT_SIMILAR_PREFIX"; Path = $trustedStagingRoot + "-sibling" },
+    @{ Name = "REJECT_OUTSIDE_TARGET"; Path = $outsideTarget },
+    @{ Name = "REJECT_NORMALIZED_SOURCE_ANCESTOR"; Path = Join-Path $trustedStagingRoot ("..\..\CrossBorder-Independent-Store") }
+  )
+  foreach ($case in $invalidPaths) {
+    [void](Invoke-StagingScript $case.Name $case.Path $false)
+  }
+
+  $unowned = Join-Path $testRoot "unowned"
+  New-TestDirectory $unowned
+  $unownedSentinel = Join-Path $unowned "sentinel.txt"
+  Write-TestFile $unownedSentinel "unowned-sentinel"
+  [void](Invoke-StagingScript "REJECT_EXISTING_NO_MARKER" $unowned $false)
+  Add-Result "NO_MARKER_CONTENT_UNCHANGED" ((Test-Path -LiteralPath $unownedSentinel) -and (Get-TestFileText $unownedSentinel) -ceq "unowned-sentinel") "sentinel-preserved"
+
+  $wrongMarker = Join-Path $testRoot "wrong-marker"
+  New-TestDirectory $wrongMarker
+  $wrongMarkerSentinel = Join-Path $wrongMarker "sentinel.txt"
+  Write-TestFile $wrongMarkerSentinel "wrong-marker-sentinel"
+  Write-TestFile (Join-Path $wrongMarker ".review-staging.marker.json") '{"marker_version":1,"marker_type":"review-staging","tool":"other-tool","package_id":"other-task"}'
+  [void](Invoke-StagingScript "REJECT_INVALID_MARKER" $wrongMarker $false)
+  Add-Result "INVALID_MARKER_CONTENT_UNCHANGED" ((Test-Path -LiteralPath $wrongMarkerSentinel) -and (Get-TestFileText $wrongMarkerSentinel) -ceq "wrong-marker-sentinel") "sentinel-preserved"
+
+  $valid = Join-Path $testRoot "owned-valid"
+  [void](Invoke-StagingScript "CREATE_VALID_NEW_STAGING" $valid $true)
+  $validMarker = Join-Path $valid ".review-staging.marker.json"
+  Add-Result "VALID_MARKER_CREATED" (Test-Path -LiteralPath $validMarker) "marker=$validMarker"
+  $markerText = Get-TestFileText $validMarker
+  Add-Result "OWNERSHIP_MARKER_NO_ABSOLUTE_PATHS" ($markerText -notmatch '(?i)[A-Z]:[\\/]Users[\\/]') "path-fingerprints-only"
+  Write-TestFile (Join-Path $valid "owned-sentinel.txt") "owned-sentinel"
+  [void](Invoke-StagingScript "RERUN_VALID_OWNED_STAGING" $valid $true)
+  Add-Result "OWNED_RERUN_REPLACED_CONTENT" ((Test-Path -LiteralPath $validMarker) -and -not (Test-Path -LiteralPath (Join-Path $valid "owned-sentinel.txt"))) "marker-remains;old-owned-file-removed"
+
+  $junctionCreated = $false
+  try {
+    New-Item -ItemType Junction -Path $junction -Target $outsideTarget -ErrorAction Stop | Out-Null
+    $junctionCreated = $true
+  } catch {
+    Add-Result "REPARSE_POINT_TEST" $true ("NOT_TESTED;environment-restriction=" + $_.Exception.Message)
+  }
+  if ($junctionCreated) {
+    $outsideSentinel = Join-Path $outsideTarget "outside-sentinel.txt"
+    [void](Invoke-StagingScript "REJECT_JUNCTION_STAGING" $junction $false)
+    Add-Result "JUNCTION_TARGET_CONTENT_UNCHANGED" ((Test-Path -LiteralPath $outsideSentinel) -and (Get-TestFileText $outsideSentinel) -ceq "outside-sentinel") "target-preserved"
+    Add-Result "REPARSE_POINT_TEST" $true "junction-rejected-before-delete"
+  }
+} finally {
+  Assert-Unchanged "SOURCE_PROTECTED_FILE_UNCHANGED" $sourceProtectedFile $sourceBefore
+  Assert-Unchanged "DOCUMENT_CENTER_PROTECTED_FILE_UNCHANGED" $documentProtectedFile $documentBefore
+  if (Test-Path -LiteralPath $junction) {
+    $junctionItem = Get-Item -LiteralPath $junction -Force
+    if (($junctionItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -eq 0) {
+      throw "Test cleanup refused to remove a non-reparse junction test path."
+    }
+    Remove-Item -LiteralPath $junction -Force
+  }
+  if (Test-Path -LiteralPath $testRoot) {
+    [System.IO.Directory]::Delete($testRoot, $true)
+  }
+  if (Test-Path -LiteralPath $outsideTarget) {
+    [System.IO.Directory]::Delete($outsideTarget, $true)
+  }
+}
+
+Write-Output "RT01_SECURITY_TEST= $(if ($failures.Count -eq 0) { 'PASS' } else { 'FAIL' })"
+Write-Output "PATH_AND_OWNERSHIP_ASSERTIONS=$($results.Count)"
+foreach ($result in $results) { Write-Output $result }
+if ($failures.Count -gt 0) {
+  Write-Output ("FAILED_ASSERTIONS=" + ($failures -join ','))
+  exit 1
+}

