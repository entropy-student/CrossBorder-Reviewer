diff --git a/.github/workflows/verify.yml b/.github/workflows/verify.yml
new file mode 100644
index 0000000..20842ba
--- /dev/null
+++ b/.github/workflows/verify.yml
@@ -0,0 +1,54 @@
+name: Verify canonical template
+
+on:
+  push:
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  verify:
+    runs-on: windows-2022
+    timeout-minutes: 30
+    env:
+      NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY: ci-public-key-fixture
+      NEXT_PUBLIC_MEDUSA_BACKEND_URL: http://127.0.0.1:9999
+      NEXT_PUBLIC_BASE_URL: http://127.0.0.1:9998
+    defaults:
+      run:
+        working-directory: 03_template/medusa-crossborder-base
+    steps:
+      - name: Checkout source repository
+        uses: actions/checkout@v4
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 20.19.0
+
+      - name: Enable pnpm 10.11.1
+        shell: bash
+        run: corepack prepare pnpm@10.11.1 --activate
+
+      - name: Resolve pnpm store
+        id: pnpm-store
+        shell: pwsh
+        run: '"path=$(pnpm store path --silent)" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append'
+
+      - name: Cache locked pnpm store
+        uses: actions/cache@v4
+        with:
+          path: ${{ steps.pnpm-store.outputs.path }}
+          key: ${{ runner.os }}-pnpm-10.11.1-${{ hashFiles('03_template/medusa-crossborder-base/pnpm-lock.yaml') }}
+          restore-keys: |
+            ${{ runner.os }}-pnpm-10.11.1-
+
+      - name: Install locked dependencies
+        run: pnpm install --frozen-lockfile
+
+      - name: Unified type, lint and provider test gate
+        run: pnpm run verify
+
+      - name: Production build gate
+        run: pnpm run verify:build
diff --git a/03_template/medusa-crossborder-base/apps/backend/scripts/run-jest.cjs b/03_template/medusa-crossborder-base/apps/backend/scripts/run-jest.cjs
