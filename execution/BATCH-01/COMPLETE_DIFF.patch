+  [void](Invoke-ChildStaging 'REJECT_CORRUPT_MARKER' $corruptMarker $false 'ownership marker is invalid')
+  Assert-Sentinel 'CORRUPT_MARKER_CONTENT_UNCHANGED' $corruptSentinel 'corrupt-marker-sentinel'
