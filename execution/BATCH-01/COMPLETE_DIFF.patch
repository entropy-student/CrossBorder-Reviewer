+          cache: pnpm
+          cache-dependency-path: 03_template/medusa-crossborder-base/pnpm-lock.yaml
+
+      - name: Enable pnpm 10.11.1
+        shell: bash
+        run: corepack prepare pnpm@10.11.1 --activate
+
+      - name: Install locked dependencies
+        run: pnpm install --frozen-lockfile
+
+      - name: Unified type, lint and provider test gate
+        run: pnpm run verify
+
+      - name: Production build gate
+        run: pnpm run verify:build
+
+      - name: Process identity security tests
+        shell: pwsh
+        run: ./scripts/process-management.security.tests.ps1
+
+      - name: Service identity security tests
