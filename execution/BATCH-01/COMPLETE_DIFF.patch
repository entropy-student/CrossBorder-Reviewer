@@ -0,0 +1,160 @@
+[CmdletBinding()]
+param()
+
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot '_common.ps1')
+
+$testRoot = Join-Path $env:TEMP ('cb-rt02-' + [Guid]::NewGuid().ToString('N'))
